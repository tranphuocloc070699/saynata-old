# Every LLM step goes one of two ways (pipeline/src/pipeline/llm.py, doc-6):
#
# 1. An Anthropic-compatible gateway (STEYG, the same keys as the backend, doc-11). On when CLAUDE_BASE_URL is set.
#    The URL without /v1; the token is sent as a Bearer token. The JSON Schema goes in the prompt and the answer is
#    read from the text (one more try on bad JSON). `collection batch` does not work here (no Batches API).
# CLAUDE_BASE_URL=https://steyg.one/api
# CLAUDE_AUTH_TOKEN=
#    The model for every step, default deepseek-v4.1-flash ($0.30 / $1.20 per million tokens in / out).
# CLAUDE_MODEL=deepseek-v4.1-flash
#    One step can have its own model. media-check and the media-ai guess send pictures: give them a model that
#    reads images, or they fail.
# CLAUDE_JUDGE_MODEL=    # topics judge
# CLAUDE_SCENE_MODEL=    # media-ai scene writer
# CLAUDE_GUESS_MODEL=    # media-ai blind guess (reads images)
# CLAUDE_CHECK_MODEL=    # media-check (reads images)
#
# 2. The Anthropic API (when CLAUDE_BASE_URL is empty): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
#    claude-haiku-5-5 (cheap, ~$0.0004 per call) or claude-sonnet-5-5 (better definitions, ~$0.008 per call).
#    The step envs above work here too.
CLAUDE_MODEL=claude-haiku-5-5
# Optional: space out calls (0 = no pacing; the SDK retries 429s itself)
# LLM_MAX_PER_MINUTE=0

# Pixabay API key for media pass: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# The server Postgres (the source of truth for the bundled dictionary): used by `import-to-postgres` and `export`.
# `export` only reads from it. On the VPS, open an SSH tunnel first (guide doc-11, section "Dictionary pipeline").
# DATABASE_URL=postgresql://app:YOUR_DB_PASSWORD@localhost:55432/english_translation

# OpenAI API key for AI sense pictures (uv run pipeline media-generate, TASK-53): https://platform.openai.com/api-keys
# Billed per image (gpt-image-1-mini, low quality: about $0.003-0.004). Set a monthly limit in the OpenAI dashboard too.
OPENAI_API_KEY=
# Where the server serves media files; media-generate --link checks a file is there before it links it.
# MEDIA_BASE_URL=https://api.saynata.com/media

# Start a prefill run on the server right after queueing (uv run pipeline prefill collect ... --now) or for rows that
# are already queued (uv run pipeline prefill run --source common-sentences). TASK-83.12, feature page "Prefill".
# The server address and an ADMIN login (the same one as the admin web app). The run spends Claude money on the server,
# capped by --max-usd (default 0.50, at most 10).
ADMIN_API_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
