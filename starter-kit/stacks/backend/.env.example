# Backend settings. Copy to backend/.env for local runs; in prod set real env vars.
# Keep comments on their own line: this file is also read as a .properties file.

# local | staging | production
APP_ENV=local
# Git SHA in CI/deploy; ties Sentry errors to a release
APP_RELEASE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=app-local-only
# "ecs" in prod (JSON log lines); empty = readable text
LOG_FORMAT=
# sentry.io -> Project settings -> Client keys. Empty = off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# false in production if the API is private
OPENAPI_ENABLED=true
