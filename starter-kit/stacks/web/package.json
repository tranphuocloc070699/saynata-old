    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "29.1.1",
    "msw": "3.0.3",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
