# Web settings. Only VITE_* keys reach the browser, so never put a secret here.
# Copy to web/.env.local for local runs.

# local | staging | production
VITE_APP_ENV=local
# Base URL of the API. Empty = same origin (/api, proxied to :8080 in dev).
VITE_API_URL=
# sentry.io -> Project settings -> Client keys. Empty = off.
VITE_SENTRY_DSN=
# GA4 measurement id (G-XXXX). Empty = analytics only logged to the console in dev.
VITE_GA4_ID=
