# Python settings. Copy to python/.env for local runs.
# local | staging | production
APP_ENV=local
# text | json
LOG_FORMAT=text
LOG_LEVEL=INFO
# console.anthropic.com -> API keys. Or leave empty and use `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Hard stop per run, in US dollars
LLM_BUDGET_USD=1.0
