# Copy to .env and fill in. .env is git-ignored.
# Five sections, by job:  1 Main LLM · 2 Fallback LLM · 3 Media (Codex) · 4 LLM spending · 5 Server, DB, admin, sign-in, email, backup.
# Production: edit backend/.env on the VPS by hand (the deploy never writes it). Switching from the old Claude keys:
# backend/scripts/migrate-env.sh, and the order in doc-11, "Switching LLM keys".

# ============================================================================================================
# 1. Main LLM: DeepSeek (sentences, words and language lines), thinking off. The backend does NOT start without a key.
# ============================================================================================================
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# The Anthropic-compatible endpoint of DeepSeek (the app sends the JSON Schema in the prompt).
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Temperature for the sentence calls (TASK-89.3). Empty = not sent. 0 gives a calmer summary.
# LLM_TEMPERATURE=0

# ============================================================================================================
# 2. Fallback LLM: Gemini. Answers the same request when DeepSeek fails before any text is streamed. Empty = no fallback.
# ============================================================================================================
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ============================================================================================================
# 3. Media: photos, and the Codex CLI that writes the AI picture scene and draws the picture
# ============================================================================================================
# Photos and short clips for the senses of new words (doc-11, section 9). Empty key = no pictures are fetched.
# Production keeps this EMPTY (TASK-115): every picture is an AI picture (pipeline: media-ai).
# Free key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Where Caddy serves the media folder (default below). Files are named in the "imageUrl" of GET /api/words/{word}.
# MEDIA_BASE_URL=https://api.saynata.com/media
# Host folder with the media files (default /var/lib/saynata/media), mounted into the container as /app/media.
# Make it once:  sudo mkdir -p /var/lib/saynata/media && sudo chown 10001:10001 /var/lib/saynata/media
# MEDIA_HOST_DIR=/var/lib/saynata/media

# AI pictures drawn from the admin with the Codex CLI and your ChatGPT login. Codex also writes the scene (the
# wand), so neither costs API money (doc-11, "AI pictures with Codex").
# Off by default. Turn it on only after you copied ~/.codex/auth.json to the server.
# AI_PICTURES_ENABLED=false
# The most pictures started per day (UTC). It protects your ChatGPT plan.
# AI_PICTURES_PER_DAY=30
# read-only is enough. If drawing fails inside Docker with a sandbox error, try workspace-write.
# AI_CODEX_SANDBOX=read-only
# Host folder with auth.json (default /var/lib/saynata/codex), mounted into the container as /app/.codex.
# Make it once:  sudo mkdir -p /var/lib/saynata/codex && sudo chown 10001:10001 /var/lib/saynata/codex
# CODEX_HOST_DIR=/var/lib/saynata/codex
# For running the backend on your Mac: the folder with your own Codex login (default ~/.codex).
# CODEX_HOME=


# ============================================================================================================
# 4. LLM spending and limits
# ============================================================================================================
# true (default) = a guest cannot cause a NEW model call (401 sign_in_required); cached and bundled answers still work.
# Set REQUIRE_SIGN_IN=false until the app with sign-in is released. The daily budget cap and a per-IP limit
# (LIMIT_CLAUDE_GUEST_IP_MAX, default 30 per hour) still apply to guests' model calls while it is false.
# REQUIRE_SIGN_IN=true
# The most the language models may cost per day, in US dollars (UTC day). At this point new explanations stop until
# midnight UTC and only cached answers work. Prices per model are in application.properties (app.claude.pricing.*).
# LLM_DAILY_BUDGET_USD=1.00
# Rate limits (defaults are in application.properties; see app.limits.*). For example:
# LIMIT_CLAUDE_USER_HOUR_MAX=60
# LIMIT_CLAUDE_USER_DAY_MAX=300
# LIMIT_PUBLIC_READ_IP_MAX=120


# Prefill job (feature page "Prefill"): answers queued words and phrases at night so users get them from the cache.
# A Spring cron (six fields: second minute hour day month weekday) in UTC. Empty (default) = it never runs by itself.
# Example: every night at 20:00 UTC (03:00 in Vietnam):
# PREFILL_CRON=0 0 20 * * *
# Which queue sources that scheduled run answers (comma list, default sentence-words = the words users typed).
# Other sources stay pending at night; start them by hand: uv run pipeline prefill run --source <label>
# PREFILL_CRON_SOURCES=sentence-words
# The most ONE run may spend on the language model, in US dollars. Separate from LLM_DAILY_BUDGET_USD (the users).
# PREFILL_MAX_USD_PER_RUN=0.50
# Optional pause after each new word (default none). Prefilled words get no picture, so nothing needs it.
# PREFILL_DELAY=0s


# ============================================================================================================
# 5. Server, database, admin, sign-in, email, backup
# ============================================================================================================
# Only for docker-compose.prod.yml (the VPS). Local dev does not need these.
# Use a long random password, for example: openssl rand -base64 24
DB_PASSWORD=
# Port on the server that the app calls (default 8081).
BACKEND_PORT=8081
# 0.0.0.0 = open to the internet. Use 127.0.0.1 when Caddy (HTTPS) is in front.
BACKEND_BIND=0.0.0.0
# Postgres on the server's own loopback only (for the dictionary pipeline through an SSH tunnel). Default 5432.
# POSTGRES_PORT=5432

# Admin web app API (/api/admin). See backlog/docs/features/doc-13 and the deploy guide.
# Signs the admin login cookie. At least 32 characters, for example: openssl rand -base64 48
ADMIN_JWT_SECRET=
# The first admin account. It is created at start-up only when no admin exists yet.
# The password needs 12+ characters. After the first start you can remove ADMIN_INITIAL_PASSWORD.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Set to false to run without the admin API (then ADMIN_JWT_SECRET is not needed).
# ADMIN_ENABLED=true

# App user accounts: sign in with an email code (doc-13 and the deploy guide, "Resend setup").
# Signs the access tokens. At least 32 characters, for example: openssl rand -base64 48
# Empty = a key is derived from ADMIN_JWT_SECRET (a warning is logged).
USER_JWT_SECRET=
# Sign-in emails are sent with Resend (deploy guide, "Resend setup"). Needs both values below.
# A "Sending access" API key from resend.com:
RESEND_API_KEY=
# The sender address, on a domain verified in Resend, for example login@loffy.me:
EMAIL_FROM=
# Optional, for later: AWS SES instead of Resend. It is used only when RESEND_API_KEY is empty and a from address
# is set (EMAIL_FROM, or the older SES_FROM_EMAIL). It must be a verified address or on a verified domain.
# With no RESEND_API_KEY and no from address, the backend only writes each code to its log: emails are NOT sent.
SES_FROM_EMAIL=
AWS_REGION=
# An IAM user that may only call ses:SendEmail (never use your root keys).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sign in with Google, Apple and an emailed link (TASK-92, doc-17; setup in the deploy guide, "Sign in with Google,
# Apple and a link").
# The iOS OAuth client ID from Google Cloud, for example 123-abc.apps.googleusercontent.com (comma-separated for more).
# Empty = the Google button answers "This sign-in option is not set up yet".
GOOGLE_CLIENT_IDS=
# The bundle IDs Apple makes ID tokens for. Default: the iOS and Mac apps.
# APPLE_CLIENT_IDS=com.luke.EnglishTranslation,com.luke.EnglishTranslation.Mac
# The public HTTPS address of this backend. The sign-in email links to PUBLIC_BASE_URL/auth/link?token=...
# Change it when the domain moves.
# PUBLIC_BASE_URL=https://api.saynata.com
# The app's URL scheme that the link page opens (saynata://sign-in?token=...).
# APP_URL_SCHEME=saynata
# Paid Apple account only: TEAMID.com.luke.EnglishTranslation. Set = the apple-app-site-association file is served,
# so iOS opens the emailed link in the app directly (universal link).
# APPLE_APP_IDS=
# Revoke Sign in with Apple tokens when an account is deleted (App Store rule; TASK-112.3, doc-11 section 13,
# "Revoke on delete"). Paid Apple account. All four set = on; any empty = Apple sign-in still works, nothing is revoked.
# APPLE_TEAM_ID: the team ID (developer.apple.com, Membership details).
# APPLE_KEY_ID and APPLE_PRIVATE_KEY: a "Sign in with Apple" key (Keys); the .p8 text, newlines written as \n.
# APPLE_TOKEN_ENCRYPTION_KEY: openssl rand -base64 32. Set once and keep it: a new key cannot read the stored tokens.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=
# Only tests change it.
# APPLE_AUTH_BASE_URL=https://appleid.apple.com

# Backups to Cloudflare R2 with restic (TASK-107, doc-11 section 17). Used only by scripts/backup.sh and restore.sh on
# the VPS; the backend container never reads them. The R2 key has its own names because AWS_ACCESS_KEY_ID above is for SES.
# The restic repository: s3:https://<account id>.r2.cloudflarestorage.com/<bucket name>
RESTIC_REPOSITORY=
# The password that encrypts the backup. Keep a copy in your password manager: without it the backup cannot be read.
RESTIC_PASSWORD=
# An R2 API token (Object Read & Write, only this bucket): Access Key ID and Secret Access Key.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: a healthchecks.io ping URL. The script pings <url>/start, then <url> on success or <url>/fail on failure.
# HEALTHCHECK_URL=
# Optional: where the last 3 dumps stay on the VPS (default /var/backups/saynata).
# BACKUP_DIR=/var/backups/saynata

# Error reporting with Sentry (TASK-128). Project saynata-backend; the DSN is in doc-24. Empty = Sentry is off.
SENTRY_DSN=
